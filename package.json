{
  "name": "jdr-bab-refacto",
  "version": "1.0.0",
  "description": "Foresia refactored modular version",
  "main": "index.html",
  "scripts": {
    "dev": "live-server --port=3000 --open=/index.html --quiet --no-css-inject --entry-file=index.html",
    "build": "node scripts/build-simple.js",
    "serve": "live-server --port=3000 --no-browser --quiet --no-css-inject",
    "dev-clean": "node scripts/utils/image-upload-server.js",
    "pwa-test": "node scripts/serve-https-fixed.js",
    "icons": "node scripts/generate-pwa-icons.js",
    "icons-png": "node scripts/generate-png-icons.js",
    "monster-icons": "node scripts/monster-icons/generate-icons.js",
    "npc-icons": "node scripts/npc-icons/generate-icons.js"
  },
  "keywords": [
    "jdr",
    "rpg",
    "webapp",
    "modular"
  ],
  "author": "Benjamin Maurin",
  "license": "ISC",
  "devDependencies": {
    "canvas": "^3.2.0",
    "form-data": "^4.0.5",
    "live-server": "^1.2.2",
    "node-fetch": "^2.7.0",
    "nodemon": "^3.0.1",
    "pdfkit": "^0.15.2",
    "selfsigned": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
