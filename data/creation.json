      "content": "<div class=\"pdf-info-container\" style=\"max-width: 100%; margin: 1rem 0; padding: 1.5rem; border: 2px solid var(--bronze); border-radius: 12px; background: var(--card); text-align: center; box-sizing: border-box; overflow: hidden;\"><p style=\"color: var(--text); margin: 1rem 0;\">Feuille de personnage complète de 3 pages pour vos aventures.</p><div class=\"pdf-preview-actions\" style=\"display: flex; flex-direction: column; gap: 1rem; align-items: center; margin-top: 1.5rem;\"><button onclick=\"const link = document.createElement('a'); link.href = 'https://github.com/ben-128/BabJdr/raw/master/data/feuille-personnage.pdf'; link.download = 'Feuille-Personnage-Foresia.pdf'; link.click();\" class=\"btn-base\" style=\"background: var(--emerald); color: white; padding: 0.75rem 2rem;\">📥 Télécharger la fiche vierge</button><button onclick=\"const formContainer = document.getElementById('creation-form-container'); const btnText = this; if (formContainer.style.display === 'none' || formContainer.style.display === '') { formContainer.style.display = 'block'; btnText.textContent = '▲ Masquer le formulaire'; if (!window.characterCreatorInitialized) { window.initCharacterCreator(); } } else { formContainer.style.display = 'none'; btnText.textContent = '▼ Créer un personnage avec calcul automatique'; }\" class=\"btn-base\" style=\"background: var(--bronze); color: white; padding: 0.75rem 2rem;\">▼ Créer un personnage avec calcul automatique</button><div id=\"creation-form-container\" style=\"display: none; margin-top: 1rem; padding: 1.5rem; border: 1px solid var(--bronze); border-radius: 8px; background: var(--bg); text-align: left; width: 100%; box-sizing: border-box;\"><p id=\"form-loading\" style=\"color: var(--text); text-align: center;\">⏳ Chargement du formulaire...</p></div></div></div>",
